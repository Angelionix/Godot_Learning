# ============================================================
# Godot Learning Platform — Конфигурация для локальной разработки
# ============================================================
# Скопируйте в .env и заполните при необходимости:
#   cp .env.example .env
#
# Все значения ниже — безопасные умолчания для локальной разработки.
# ============================================================

# --- Режим окружения ---
NODE_ENV=development

# --- База данных (SQLite через Prisma) ---
# Для локальной разработки:
DATABASE_URL=file:./db/custom.db

# --- S3 / MinIO — хранилище файлов проектов ---
# Для локальной разработки (запустить MinIO через Docker):
#   docker compose up -d minio minio-init
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=user-projects

# --- Godot Web Editor ---
# URL адрес Godot Web Editor из браузера.
# Для локальной разработки с Docker:
#   docker compose up -d godot-editor
GODOT_EDITOR_URL=http://localhost:8080
