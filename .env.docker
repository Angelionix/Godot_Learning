# ============================================================
# Godot Learning Platform — Пример конфигурации для Docker
# ============================================================
#
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.docker .env
#
# Все значения ниже — безопасные умолчания для локальной разработки.
# Для production обязательно замените пароли и секреты!
# ============================================================

# --- Режим окружения ---
# production  — для Docker-контейнера (оптимизированная сборка, нет горячей перезагрузки)
# development — для локальной разработки (hot reload, подробные логи)
NODE_ENV=production

# --- База данных (SQLite через Prisma) ---
# Путь к файлу БД внутри контейнера.
# В docker-compose том (volume) монтируется в /app/db,
# поэтому данные сохраняются между перезапусками.
# Для локальной разработки вне Docker: file:/home/z/my-project/db/custom.db
DATABASE_URL=file:/app/db/custom.db

# --- S3 / MinIO — хранилище файлов проектов ---
# Адрес S3-совместимого хранилища.
# В Docker: http://minio:9000 (имя сервиса в docker-compose)
# Локально: http://localhost:9000
S3_ENDPOINT=http://minio:9000

# Регион S3. Для MinIO обычно us-east-1
S3_REGION=us-east-1

# Ключ доступа (Access Key) для S3/MinIO.
# Для локальной разработки MinIO использует значение по умолчанию.
S3_ACCESS_KEY=minioadmin

# Секретный ключ (Secret Key) для S3/MinIO.
# ВАЖНО: для production замените на надёжный пароль!
S3_SECRET_KEY=minioadmin

# Название бакета (bucket) для хранения файлов проектов.
# Бакет будет создан автоматически при первом запуске (minio-init).
S3_BUCKET=user-projects

# --- Godot Web Editor ---
# URL адрес Godot Web Editor, доступный из браузера пользователя.
# В Docker с nginx: http://localhost:8080
# Для production замените на реальный домен, например:
#   https://editor.godot-learning.example.com
GODOT_EDITOR_URL=http://localhost:8080

# --- MinIO Console (управление через веб-интерфейс) ---
# Логин администратора MinIO. Используется также как S3_ACCESS_KEY.
# ВАЖНО: для production замените на надёжное имя пользователя!
MINIO_ROOT_USER=minioadmin

# Пароль администратора MinIO. Используется также как S3_SECRET_KEY.
# ВАЖНО: для production замените на надёжный пароль!
MINIO_ROOT_PASSWORD=minioadmin
