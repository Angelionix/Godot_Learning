generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default("default-user")
  username        String   @unique @default("student")
  email           String?
  avatarUrl       String?
  xp              Int      @default(0)
  level           Int      @default(1)
  streak          Int      @default(0)
  lastActiveDate  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  progress          Progress[]
  badges            Badge[]
  challengeAttempts ChallengeAttempt[]
  editorSessions    EditorSession[]
  editorProjects    EditorProject[]
  submissions       ProjectSubmission[]
}

model Progress {
  id          String    @id @default(cuid())
  userId      String
  projectSlug String
  chapterSlug String
  completed   Boolean   @default(false)
  completedAt DateTime?
  xpEarned    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectSlug, chapterSlug])
}

model Badge {
  id          String   @id @default(cuid())
  userId      String
  slug        String
  name        String
  description String
  iconUrl     String?
  earnedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
}

model ChallengeAttempt {
  id            String   @id @default(cuid())
  userId        String
  projectSlug   String
  chapterSlug   String
  challengeSlug String
  passed        Boolean  @default(false)
  attempts      Int      @default(1)
  code          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectSlug, chapterSlug, challengeSlug])
}

/// Сессия Godot Web Editor — отслеживает активные сессии пользователей
model EditorSession {
  id            String   @id @default(cuid())
  userId        String
  projectSlug   String   // К какому проекту курса привязана сессия
  status        String   @default("active") // active | expired | closed
  editorUrl     String?  // URL инстанса Godot Web Editor
  lastActivity  DateTime @default(now())
  expiresAt     DateTime // Таймаут сессии (2 часа от создания/обновления)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/// Проект пользователя в Godot Editor — хранит метаданные, файлы лежат в S3
model EditorProject {
  id            String   @id @default(cuid())
  userId        String
  projectSlug   String   // project-1-clicker и т.д.
  name          String   // Пользовательское название проекта
  description   String?
  s3Key         String   // Ключ в S3: {userId}/{projectSlug}/{id}/
  sizeBytes     Int      @default(0) // Размер проекта в байтах
  fileCount     Int      @default(0) // Количество файлов
  templateSlug  String?  // Из какого шаблона создан
  isTemplate    Boolean  @default(false) // Является ли шаблоном
  lastOpenedAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, projectSlug])
}

/// Результат автогрейдинга — хранит историю проверок проектов
model ProjectSubmission {
  id            String   @id @default(cuid())
  userId        String
  projectId     String   // Ссылка на EditorProject
  projectSlug   String   // project-1-clicker и т.д.
  status        String   @default("pending") // pending | running | passed | failed | error
  totalTests    Int      @default(0)
  passedTests   Int      @default(0)
  failedTests   Int      @default(0)
  skippedTests  Int      @default(0)
  duration      Int      @default(0) // milliseconds
  xpEarned      Int      @default(0)
  testResults   String   // JSON string with detailed test results
  errorMessage  String?  // Error message if grading failed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, projectId])
  @@index([userId, projectSlug])
}
